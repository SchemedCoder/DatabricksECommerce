# E-Commerce ETL Pipeline - Environment Configurations

# Application Environment (local or production)
ENV=local
APP_NAME=EcommercePipeline

# Local / Volume Data Paths
ORDERS_PATH=data/orders.csv
CUSTOMERS_PATH=data/customers.csv
PAYMENTS_PATH=data/payments.csv

# Snowflake Warehousing Configuration
# Fill these with your Snowflake credentials for Gold Warehousing
SF_USER=your_snowflake_username
SF_PASSWORD=your_snowflake_password
SF_ACCOUNT=your_snowflake_account_id
SF_WAREHOUSE=COMPUTE_WH
SF_DATABASE=ECOMMERCE_DB
SF_SCHEMA=PUBLIC
SF_ROLE=SYSADMIN
